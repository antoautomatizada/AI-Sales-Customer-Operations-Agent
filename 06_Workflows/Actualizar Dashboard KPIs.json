    {
      "parameters": {
        "jsCode": "const kpis = $('Code').first().json;\nconst registros = $input.all();\n\nconst valores = {\n  'Total de Leads': kpis.totalLeads,\n  'Total de Interacciones': kpis.totalInteractions,\n  'Respuestas Enviadas': kpis.respuestasEnviadas,\n  'Total de Errores': kpis.totalErrores,\n  'Tasa de Errores': kpis.tasaErrores\n};\n\nreturn registros.map(item => {\n  const nombreKPI = item.json.fields.KPI;\n\n  return {\n    json: {\n      id: item.json.id,\n      KPI: nombreKPI,\n      Valor: valores[nombreKPI],\n      Descripcion: item.json.fields.DESCRIPCION,\n      UltimaActualizacion: kpis.fechaActualizacion\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        112
      ],
      "id": "de9985f8-88d1-4c80-bab2-ef0682ba3450",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst totalLeads = items.filter(item =>\n  item.json.fields?.['Lead ID']\n).length;\n\nconst totalInteractions = items.filter(item =>\n  item.json.fields?.['Interaction ID']\n).length;\n\nconst respuestasEnviadas = items.filter(item =>\n  item.json.fields?.['Respuesta enviada']?.toLowerCase() === 'si'\n).length;\n\nconst totalErrores = items.filter(item =>\n  item.json.fields?.['Error ID']\n).length;\n\nconst tasaErrores = totalInteractions > 0\n  ? Number(((totalErrores / totalInteractions) * 100).toFixed(2))\n  : 0;\n\nreturn [\n  {\n    json: {\n      totalLeads,\n      totalInteractions,\n      respuestasEnviadas,\n      totalErrores,\n      tasaErrores,\n      fechaActualizacion: new Date().toISOString()\n    }\n  }\n];"
      },
